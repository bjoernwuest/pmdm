# PostgreSQL connection string (required; startup fails without it)
DATABASE_URL=postgresql://user:password@localhost:5432/pmdm

# PostgreSQL advisory-lock ID used by programmatic migrations
# (optional; default: -7482650123549836421 from src/services/Env.ts)
# ADVISORY_LOCK=-7482650123549836421

# HTTP server port (optional; default: 8000)
# PORT=8000

# Opt-in development mode (optional; set to "1" to enable; unset means production behavior)
# DEV_MODE=1

# Drizzle SQL logging (optional; set to "1" to enable)
# SQL_LOGGING=1

# Base URL for request-bundling loopback calls
# (optional; falls back to http://localhost:<PORT>)
# INTERNAL_API_BASE_URL=http://localhost:8000

# Extra request-bundling debug logging (optional; set to "1" to enable)
# BUNDLING_DEBUG=1

# Trust X-Forwarded-Proto/X-Forwarded-Host headers (optional; set to "1" only behind
# a reverse proxy that terminates TLS and overwrites both headers)
# TRUST_PROXY=1

# Base URL for the Playwright E2E test infrastructure (test-only; not read by the application)
# APP_BASE_URL=http://localhost:8000

# Not load-bearing inside application code (exported raw only)
# NODE_ENV=production

# Enable debug output in browser console; 1=enable
#DEBUG_FRONTEND=1
