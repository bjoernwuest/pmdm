{
  "name": "bun-starter",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "ts-morph": "^28.0.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "drizzle": "bun drizzle-kit generate --dialect postgresql --schema 'src/schema/*.ts' --out ./src/migrations --prefix timestamp && bun scripts/generate_umzug_templates.ts",
    "typegen": "bun run scripts/generate_types.ts",
    "typegen:watch": "bun --watch scripts/generate_types.ts",
    "dev": "DEV_MODE=1 bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir ./dist",
    "start": "bun dist/main.js",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@elysia/server-timing": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@scalar/openapi-to-markdown": "^0.5.39",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.29",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "openid-client": "^6.8.5",
    "postgres": "^3.4.9",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "umzug": "^3.8.3"
  }
}
